{
  "name": "memex",
  "version": "0.1.0",
  "description": "memex personal-knowledge brain — vector + keyword search over the Obsidian vault and ingested data, with Bedrock Titan embeddings.",
  "type": "module",
  "private": true,
  "bin": {
    "memex": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "test": "bun test",
    "start": "bun run src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "@aws-sdk/client-secrets-manager": "^3.658.0",
    "@electric-sql/pglite": "^0.2.17",
    "chokidar": "5.0.0",
    "postgres": "3.4.9",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "tree-sitter-python": "0.23.6",
    "tree-sitter-typescript": "0.23.2"
  }
}
