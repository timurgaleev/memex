# memex.yml — declarative runtime configuration overlay.
#
# Optional. Place at ~/.memex/memex.yml. Layered ON TOP of the JSON
# config (~/.memex/config.json) which `memex init` writes — that
# JSON only carries boot-essentials (database path, embedding provider).
#
# Precedence (highest first):
#   1. process env (MEMEX_*)
#   2. this file
#   3. config.json
#   4. defaults

# ---------------------------------------------------------------------------
# Vault paths to index. Supports a multi-path layout (synced + local).
# ---------------------------------------------------------------------------
# `synced` paths sit inside an externally-synced vault — they may be visible
# across devices and edited from outside this host. `local` paths live only
# on the host (workspace memory etc.) and never round-trip through any
# external sync.
vault_paths:
  synced:
    - /vault
  local:
    - /memory

# ---------------------------------------------------------------------------
# Initial-sweep throttle on small instances.
# ---------------------------------------------------------------------------
sweep:
  per_file_delay_ms: 50    # ~20 docs/sec when sequential
  max_files: 1000          # safety cap; remove after first full sweep

# ---------------------------------------------------------------------------
# Dream loop — periodic re-embed of stale chunks.
# ---------------------------------------------------------------------------
# `interval_s` < 60 disables the loop. Recommended: 21600 (6h).
# A quiet-hours window is honoured by default (reserves CPU for
# interactive MCP traffic then); both window bounds and zone are configurable.
dream:
  interval_s: 21600
  stale_days: 30

# ---------------------------------------------------------------------------
# MCP transport — agents connect to POST /mcp.
# ---------------------------------------------------------------------------
mcp:
  enabled: true
  rate_limit_per_minute: 60

# ---------------------------------------------------------------------------
# Optional self-issued OAuth 2.1 (client_credentials). DEFAULT-OFF.
# ---------------------------------------------------------------------------
# Leave this block out (or `enabled: false`) and nothing changes — the single
# static public bearer stays the only auth path. When enabled, memex mounts a
# POST /token endpoint and verifies its own `memex_at_…` tokens on the /mcp
# ingress, scoping each request to the registered client's source set. No
# external IdP — memex IS the authorization server.
#
#   1. memex auth register-client <name> --scopes "read write" --source <id>
#        → prints client_id (memex_cl_…) + client_secret (memex_cs_…) ONCE.
#   2. curl -X POST https://brain.<domain>/token \
#        -d grant_type=client_credentials -d client_id=… -d client_secret=…
#        → { access_token: "memex_at_…", token_type: "bearer", expires_in: 3600 }
#   3. present it as `Authorization: Bearer memex_at_…` on /mcp.
#
# auth:
#   selfIssued:
#     enabled: true
