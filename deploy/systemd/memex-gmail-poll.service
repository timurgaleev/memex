[Unit]
Description=Hourly Gmail recipe poll (signal-detect → Postgres index)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/memex/bin/gmail-poll.sh
User=root
# Honour Berlin local clock — recipe's `throttle.preflight` declines
# during 06:00–08:00 quiet hours, so the timer can fire at any wall
# clock without colliding with the morning briefing.
Environment=TZ=Europe/Berlin
# Knobs (override here if 50 msg/hour ever feels wrong; recipe also
# reads them from the secret's poll_minutes / signal_threshold).
Environment=MEMEX_GMAIL_POLL_MAX=50
Environment=MEMEX_GMAIL_POLL_SINCE_HOURS=24
StandardOutput=append:/var/log/memex/memex-gmail-poll.log
StandardError=append:/var/log/memex/memex-gmail-poll.log
