[Unit]
Description=Hourly Gmail recipe poll at :15 Europe/Berlin

[Timer]
# :15 instead of top-of-hour to avoid colliding with the morning
# briefing (cron 0 7 * * * @ Europe/Berlin) and the daily bearer
# rotation (06:00 Europe/Berlin). Quiet-hours filtering still happens
# inside the recipe via throttle.preflight, so 06:15 + 07:15 polls
# return early with reason="throttle:quiet-hours" — no API cost burned.
OnCalendar=*-*-* *:15:00 Europe/Berlin
# If the EC2 was sleeping (spot rebalance, planned maintenance) and
# missed a slot, run as soon as it's back rather than waiting for
# the next hour.
Persistent=true
Unit=memex-gmail-poll.service

[Install]
WantedBy=timers.target
