#!/bin/bash
# Home Assistant CLI — credentials fetched from Secrets Manager at runtime.
# Usage:
#   ha states [filter]
#   ha get /api/...
#   ha call <domain> <service> [json]
#   ha history <entity_id> [hours]
#
# Env contract:
#   AWS_REGION       Required.
#   SECRETS_PREFIX   Namespace; defaults to memex.

set -euo pipefail

: "${AWS_REGION:?AWS_REGION must be set in the container environment}"
SECRETS_PREFIX="${SECRETS_PREFIX:-memex}"

# Single-pass secret read: parse the JSON once with python so the raw
# SecretString never lives in a shell variable that other tools could
# read from /proc. eval(){URL,TOKEN} pulls only the two fields we need.
eval "$(aws secretsmanager get-secret-value \
  --secret-id "${SECRETS_PREFIX}/home-assistant-token" \
  --region "$AWS_REGION" \
  --query SecretString \
  --output text \
  | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'HA_URL={d[\"HA_URL\"]!r}'); print(f'HA_TOKEN={d[\"HA_TOKEN\"]!r}')")"

# Authorization header is passed to curl via a config-from-fd, so the
# bearer never appears in /proc/<pid>/cmdline (visible to `ps` from any
# user on a shared host). The header file is kept under tmpfs with mode
# 0600 and removed on script exit.
HDR_FILE="$(mktemp)"
trap 'rm -f "$HDR_FILE"; unset HA_TOKEN' EXIT
chmod 0600 "$HDR_FILE"
printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$HA_TOKEN" > "$HDR_FILE"
unset HA_TOKEN
CURL_OPTS="--config $HDR_FILE -sf"

cmd="${1:-}"; shift || true

case "$cmd" in
  get)
    # shellcheck disable=SC2086
    curl $CURL_OPTS "$HA_URL$1" | python3 -m json.tool
    ;;
  states)
    filter="${1:-}"
    # shellcheck disable=SC2086
    HA_FILTER="$filter" curl $CURL_OPTS "$HA_URL/api/states" | python3 -c "
import sys,json,os
states=json.load(sys.stdin)
flt=os.environ.get('HA_FILTER','')
for s in states:
    if not flt or flt in s['entity_id']:
        print(s['entity_id'],'=',s['state'])
"
    ;;
  call)
    domain="$1"; service="$2"; data="${3:-{}}"
    # shellcheck disable=SC2086
    curl $CURL_OPTS -X POST "$HA_URL/api/services/$domain/$service" -d "$data" | python3 -m json.tool
    ;;
  history)
    entity="$1"; hours="${2:-1}"
    start=$(python3 -c "from datetime import datetime,timedelta,timezone; print((datetime.now(timezone.utc)-timedelta(hours=$hours)).isoformat())")
    # shellcheck disable=SC2086
    curl $CURL_OPTS "$HA_URL/api/history/period/$start?filter_entity_id=$entity" | python3 -c "
import sys,json
data=json.load(sys.stdin)
if data:
    for s in data[0][-10:]:
        print(s.get('last_changed','')[:19], s.get('state',''))
"
    ;;
  *)
    echo "Usage: ha <states|get|call|history> [args]"
    ;;
esac
