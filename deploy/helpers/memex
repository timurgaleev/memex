#!/bin/bash
# memex — thin client for the memex daemon, mounted into the
# telegram-bridge container for ad-hoc shells. Talks to the single MCP
# JSON-RPC endpoint (POST /mcp) on the docker-internal network at
# http://memex:18790 — the legacy REST routes were removed in A.7.
#
# Usage:
#   memex search <query> [limit]      # default limit 5, returns JSON
#   memex index <path>                # index a markdown file by path
#   memex health                      # quick liveness check
#
# `index` is a write tool and requires the internal token: the helper
# sends $MEMEX_INTERNAL_TOKEN (present in the bridge container env) as a
# bearer. Reads (`search`) work with or without it.
#
# Output is the tool's JSON payload. Pipe through `jq` for human reading.
# Errors land on stderr with a non-zero exit code.
set -euo pipefail

BRAIN_URL="${BRAIN_URL:-http://memex:18790}"
CMD="${1:-}"
shift || true

# POST a tools/call envelope and print the tool's JSON payload (the text
# of the first content block). Args: <tool-name> <arguments-json>.
mcp_call() {
  local name="$1" args="$2"
  local body resp
  body=$(jq -nc --arg n "$name" --argjson a "$args" \
    '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$n,arguments:$a}}')
  # Send the internal token when present (required for write tools, e.g.
  # index). Two explicit branches keep this portable under `set -u` across
  # bash versions (an empty array expansion is not).
  if [ -n "${MEMEX_INTERNAL_TOKEN:-}" ]; then
    resp=$(curl -fsS -X POST -H "Content-Type: application/json" \
      -H "Authorization: Bearer ${MEMEX_INTERNAL_TOKEN}" \
      --data "$body" "${BRAIN_URL}/mcp")
  else
    resp=$(curl -fsS -X POST -H "Content-Type: application/json" \
      --data "$body" "${BRAIN_URL}/mcp")
  fi
  # Surface JSON-RPC errors (e.g. -32001 unauthorized) on stderr.
  if echo "$resp" | jq -e '.error' >/dev/null 2>&1; then
    echo "memex: $(echo "$resp" | jq -r '.error.message')" >&2
    exit 1
  fi
  echo "$resp" | jq -r '.result.content[0].text'
}

case "$CMD" in
  search)
    QUERY="${1:-}"
    LIMIT="${2:-5}"
    if [ -z "$QUERY" ]; then
      echo "memex search: <query> required" >&2
      exit 2
    fi
    mcp_call search "$(jq -nc --arg q "$QUERY" --argjson k "$LIMIT" '{q:$q,k:$k}')"
    ;;
  index)
    P="${1:-}"
    if [ -z "$P" ]; then
      echo "memex index: <path> required" >&2
      exit 2
    fi
    mcp_call index "$(jq -nc --arg path "$P" '{path:$path}')"
    ;;
  health)
    curl -fsS "${BRAIN_URL}/health"
    echo
    ;;
  ""|-h|--help|help)
    cat <<USAGE
memex — query the personal-knowledge brain (via MCP /mcp).

Commands:
  search <query> [limit]   hybrid retrieve (default limit 5), prints JSON
  index <path>             read a markdown file and index it (needs token)
  health                   liveness check on the memex daemon

Env: BRAIN_URL              override the daemon endpoint (default http://memex:18790)
     MEMEX_INTERNAL_TOKEN   bearer for write tools (e.g. index)
USAGE
    ;;
  *)
    echo "memex: unknown subcommand '$CMD'" >&2
    exit 2
    ;;
esac
