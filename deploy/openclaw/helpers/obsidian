#!/usr/bin/env python3
"""
obsidian — read/write/search an Obsidian vault from the chat container.

The vault is bidirectionally synced via obsidian-headless; reads see
edits made elsewhere within ~60 s, writes propagate to other paired
devices within ~60 s.

Writes are restricted to a configured write-allowed subtree to protect
human-authored notes.

Usage:
  obsidian read <path>                         # read any file inside the vault
  obsidian write <path> [<content>]            # overwrite (write-allowed subtree only)
  obsidian append <path> [<content>]           # append (write-allowed only); creates if missing
  obsidian search <query> [limit]              # recursive grep across vault
  obsidian list [folder]                       # list .md files
  obsidian journal-today                       # print today's journal path

<content> may be passed as an argument or via stdin.
"""
from __future__ import annotations

import datetime as _dt
import os
import sys
from pathlib import Path

_PROJECT = os.environ.get("STACK_PROJECT", "memex")
VAULT_ROOT = Path(
    os.environ.get(
        "OBSIDIAN_VAULT",
        f"/mnt/{_PROJECT}-efs/{_PROJECT}/vault"
        if os.path.ismount(f"/mnt/{_PROJECT}-efs")
        else f"/home/openclaw/.openclaw/vault",
    )
)
WRITE_SUBTREE = os.environ.get("OBSIDIAN_WRITE_ROOT", "")


def _today() -> _dt.date:
    return _dt.date.today()


def _resolve(rel: str) -> Path:
    if rel.startswith("/"):
        print("ERROR: absolute paths are not allowed", file=sys.stderr)
        sys.exit(2)
    target = (VAULT_ROOT / rel).resolve()
    try:
        target.relative_to(VAULT_ROOT.resolve())
    except ValueError:
        print(f"ERROR: path escapes vault root: {rel}", file=sys.stderr)
        sys.exit(2)
    return target


def resolve_read_path(rel: str) -> Path:
    return _resolve(rel)


def resolve_write_path(rel: str) -> Path:
    target = _resolve(rel)
    subtree = (VAULT_ROOT / WRITE_SUBTREE).resolve()
    try:
        target.relative_to(subtree)
    except ValueError:
        print(
            f"ERROR: writes are restricted to {WRITE_SUBTREE}/ — refusing {rel}",
            file=sys.stderr,
        )
        sys.exit(2)
    return target


def _read_content(arg: str | None) -> str:
    if arg is not None:
        return arg
    return sys.stdin.read()


def cmd_read(rel: str) -> str:
    """Return file contents; empty string if file does not yet exist.

    The skill's mandatory boot sequence reads identity/context notes that may
    not have been seeded yet. We don't want a missing memory file to abort the
    sequence — return empty so the caller proceeds.
    """
    p = resolve_read_path(rel)
    if not p.exists():
        return ""
    return p.read_text()


def cmd_write(rel: str, content: str | None) -> None:
    target = resolve_write_path(rel)
    target.parent.mkdir(parents=True, exist_ok=True)
    body = _read_content(content)
    target.write_text(body if body.endswith("\n") else body + "\n")


def cmd_append(rel: str, content: str | None) -> None:
    target = resolve_write_path(rel)
    target.parent.mkdir(parents=True, exist_ok=True)
    body = _read_content(content)
    if not body.endswith("\n"):
        body += "\n"
    if target.exists() and target.stat().st_size > 0:
        existing = target.read_text()
        if not existing.endswith("\n"):
            existing += "\n"
        target.write_text(existing + "\n" + body)
    else:
        target.write_text(body)


# 5 MiB per-file cap protects the container from OOM on a stray
# binary-as-markdown commit or a runaway log; vault notes are
# typically <100 KiB. Symlinks are skipped to defuse escape-by-symlink.
_OBSIDIAN_MAX_FILE_BYTES = 5 * 1024 * 1024


def cmd_search(query: str, limit: int = 10) -> list[str]:
    results: list[str] = []
    needle = query.lower()
    for path in sorted(VAULT_ROOT.rglob("*.md")):
        try:
            if path.is_symlink():
                continue
            if path.stat().st_size > _OBSIDIAN_MAX_FILE_BYTES:
                continue
            for i, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
                if needle in line.lower():
                    rel = path.relative_to(VAULT_ROOT).as_posix()
                    snippet = line.strip()[:160]
                    results.append(f"{rel}:{i}: {snippet}")
                    if len(results) >= limit:
                        return results
        except OSError:
            continue
    return results


def cmd_list(folder: str = WRITE_SUBTREE) -> list[str]:
    base = resolve_read_path(folder)
    if not base.is_dir():
        return []
    return sorted(
        p.relative_to(VAULT_ROOT).as_posix()
        for p in base.rglob("*.md")
    )


def cmd_journal_today() -> str:
    return f"{WRITE_SUBTREE}/journal/{_today().isoformat()}.md"


def main() -> None:
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(0)
    cmd = sys.argv[1]
    args = sys.argv[2:]
    if cmd == "read":
        if not args:
            print("Usage: obsidian read <path>", file=sys.stderr)
            sys.exit(2)
        sys.stdout.write(cmd_read(args[0]))
    elif cmd == "write":
        if not args:
            print("Usage: obsidian write <path> [<content>]", file=sys.stderr)
            sys.exit(2)
        cmd_write(args[0], args[1] if len(args) > 1 else None)
    elif cmd == "append":
        if not args:
            print("Usage: obsidian append <path> [<content>]", file=sys.stderr)
            sys.exit(2)
        cmd_append(args[0], args[1] if len(args) > 1 else None)
    elif cmd == "search":
        if not args:
            print("Usage: obsidian search <query> [limit]", file=sys.stderr)
            sys.exit(2)
        limit = int(args[1]) if len(args) > 1 else 10
        for line in cmd_search(args[0], limit=limit):
            print(line)
    elif cmd == "list":
        folder = args[0] if args else WRITE_SUBTREE
        for line in cmd_list(folder):
            print(line)
    elif cmd == "journal-today":
        print(cmd_journal_today())
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
