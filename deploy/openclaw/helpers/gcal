#!/usr/bin/env python3
"""
gcal — Google Calendar CLI for the memex stack.
Credentials auto-fetched from AWS Secrets Manager
(`${SECRETS_PREFIX}/google-calendar`).

Usage:
  gcal today               Today's events
  gcal tomorrow            Tomorrow's events
  gcal week                Next 7 days
  gcal list [days]         Next N days (default 7)
  gcal calendars           List all calendars
  gcal search <query>      Search events (next 30 days)
"""
import sys, json, urllib.request, urllib.parse, datetime

import os
REGION = os.environ.get("AWS_REGION", "eu-west-1")
SECRET_ID = f"{os.environ.get('SECRETS_PREFIX', 'memex')}/google-calendar"
TOKEN_URL = "https://oauth2.googleapis.com/token"
CAL_API = "https://www.googleapis.com/calendar/v3"


def get_credentials():
    import subprocess
    result = subprocess.run([
        "aws", "secretsmanager", "get-secret-value",
        "--secret-id", SECRET_ID, "--region", REGION,
        "--query", "SecretString", "--output", "text"
    ], capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Cannot read secret: {result.stderr}")
    return json.loads(result.stdout)


def get_access_token(creds):
    data = urllib.parse.urlencode({
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "refresh_token": creds["refresh_token"],
        "grant_type": "refresh_token",
    }).encode()
    req = urllib.request.Request(TOKEN_URL, data=data, method="POST")
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())["access_token"]


def api_get(path, token, params=None):
    url = CAL_API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())


def parse_dt(dt_str):
    return datetime.datetime.fromisoformat(dt_str.replace("Z", "+00:00"))


def short_cal_name(name):
    if name.startswith("webcal://") or name.startswith("http"):
        return "Calendar"
    return name


def fmt_event(e, show_cal=False):
    start = e.get("start", {})
    dt = start.get("dateTime", start.get("date", ""))
    if "T" in dt:
        t = parse_dt(dt).astimezone()
        time_str = t.strftime("%H:%M")
        date_str = t.strftime("%a %d %b")
    else:
        time_str = "all-day"
        date_str = datetime.datetime.strptime(dt, "%Y-%m-%d").strftime("%a %d %b") if dt else ""
    title = e.get("summary", "(no title)")
    loc = e.get("location", "")
    line = f"{date_str} {time_str}  {title}"
    if loc:
        line += f"  📍{loc.split(',')[0]}"
    if show_cal and e.get("_calendar"):
        line += f"  [{short_cal_name(e['_calendar'])}]"
    return line


def get_events(token, days=7, query=None):
    now = datetime.datetime.utcnow()
    time_min = now.strftime("%Y-%m-%dT00:00:00Z")
    time_max = (now + datetime.timedelta(days=days)).strftime("%Y-%m-%dT23:59:59Z")
    cals = api_get("/users/me/calendarList", token)
    events = []
    for cal in cals.get("items", []):
        cal_id = cal["id"]
        cal_name = cal.get("summary", cal_id)
        params = {
            "timeMin": time_min, "timeMax": time_max,
            "singleEvents": "true", "orderBy": "startTime", "maxResults": "50",
        }
        if query:
            params["q"] = query
        try:
            result = api_get(f"/calendars/{urllib.parse.quote(cal_id)}/events", token, params)
            for e in result.get("items", []):
                e["_calendar"] = cal_name
                events.append(e)
        except Exception:
            pass
    events.sort(key=lambda e: e.get("start", {}).get("dateTime", e.get("start", {}).get("date", "")))
    return events


def cmd_calendars(token):
    cals = api_get("/users/me/calendarList", token)
    print(f"{'Calendar':<40} {'Access':<15} Primary")
    print("-" * 65)
    for c in cals.get("items", []):
        name = short_cal_name(c.get("summary", c["id"]))[:38]
        access = c.get("accessRole", "?")
        primary = "✓" if c.get("primary") else ""
        print(f"{name:<40} {access:<15} {primary}")


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        sys.exit(0)
    cmd = args[0].lower()
    try:
        creds = get_credentials()
        token = get_access_token(creds)
    except Exception as e:
        print(f"Auth error: {e}", file=sys.stderr)
        sys.exit(1)

    if cmd == "calendars":
        cmd_calendars(token)
    elif cmd == "today":
        today = datetime.date.today().isoformat()
        events = get_events(token, days=1)
        print(f"📅 Today ({datetime.date.today().strftime('%a %d %b')}):")
        shown = [e for e in events if e.get("start", {}).get("dateTime", e.get("start", {}).get("date", ""))[:10] == today]
        for e in shown: print(f"  {fmt_event(e, show_cal=True)}")
        if not shown: print("  No events today.")
    elif cmd == "tomorrow":
        tomorrow = datetime.date.today() + datetime.timedelta(days=1)
        events = get_events(token, days=2)
        print(f"📅 Tomorrow ({tomorrow.strftime('%a %d %b')}):")
        shown = [e for e in events if e.get("start", {}).get("dateTime", e.get("start", {}).get("date", ""))[:10] == tomorrow.isoformat()]
        for e in shown: print(f"  {fmt_event(e, show_cal=True)}")
        if not shown: print("  No events tomorrow.")
    elif cmd == "week":
        events = get_events(token, days=7)
        print(f"📅 Next 7 days ({len(events)} events):")
        for e in events: print(f"  {fmt_event(e, show_cal=True)}")
    elif cmd == "list":
        days = int(args[1]) if len(args) > 1 else 7
        events = get_events(token, days=days)
        print(f"📅 Next {days} days ({len(events)} events):")
        for e in events: print(f"  {fmt_event(e, show_cal=True)}")
    elif cmd == "search":
        if len(args) < 2:
            print("Usage: gcal search <query>"); sys.exit(1)
        query = " ".join(args[1:])
        events = get_events(token, days=30, query=query)
        print(f"🔍 Search '{query}' ({len(events)} results):")
        for e in events: print(f"  {fmt_event(e, show_cal=True)}")
    else:
        print(f"Unknown command: {cmd}"); print(__doc__); sys.exit(1)


if __name__ == "__main__":
    main()
