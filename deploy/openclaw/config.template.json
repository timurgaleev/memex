{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "allowedOrigins": ["https://${PUBLIC_HOST}"],
      "allowInsecureAuth": true
    },
    "trustedProxies": ["127.0.0.1", "172.16.0.0/12"]
  },
  "channels": {
    "telegram": {
      "groupPolicy": "open"
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "amazon-bedrock": {
        "baseUrl": "https://bedrock-runtime.${AWS_REGION}.amazonaws.com",
        "api": "bedrock-converse-stream",
        "auth": "aws-sdk",
        "models": [
          {
            "id": "eu.anthropic.claude-haiku-4-5-20251001-v1:0",
            "name": "Claude Haiku 4.5",
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "global.amazon.nova-2-lite-v1:0",
            "name": "Nova 2 Lite",
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "amazon-bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0",
        "fallbacks": ["amazon-bedrock/global.amazon.nova-2-lite-v1:0"]
      },
      "models": {
        "amazon-bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0": {},
        "amazon-bedrock/global.amazon.nova-2-lite-v1:0": {}
      },
      "thinkingDefault": "off",
      "reasoningDefault": "off",
      "heartbeat": {
        "every": ""
      },
      "memorySearch": {
        "enabled": false
      }
    }
  }
}
