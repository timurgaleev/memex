# backend.hcl.example — copy to backend.hcl (gitignored) and fill in,
# OR run `scripts/init.sh` which generates this file from your prompts.
#
# Loaded by:
#   terraform init -backend-config=backend.hcl
#
# The S3 bucket must exist before `terraform init` — create it by hand the
# first time, with versioning on (drop the LocationConstraint in us-east-1):
#   aws s3api create-bucket --bucket <bucket> --region <region> \
#     --create-bucket-configuration LocationConstraint=<region>
#   aws s3api put-bucket-versioning --bucket <bucket> \
#     --versioning-configuration Status=Enabled

bucket  = "your-tfstate-bucket-name"
# An existing stack keeps its key. Changing it without
# `terraform init -migrate-state` starts from an empty state.
key     = "memrain/terraform.tfstate"
region  = "eu-central-1"
encrypt = true
profile = "default"
