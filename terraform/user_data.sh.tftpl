#!/bin/bash
# Cloud-init user_data — runs once on first boot. Writes the env contract
# bootstrap.sh expects, then fetches and runs bootstrap.sh from S3.
set -euo pipefail

cat > /etc/stack-env <<EOF
# Generated by terraform user_data — bootstrap.sh sources this.
STACK_EFS_ID=${efs_id}
STACK_REPO_URL=${repo_url}
STACK_PROJECT=${project_name}
STACK_USE_SSH_DEPLOY_KEY=${use_ssh_deploy_key}
STACK_SECRETS_PREFIX=${secrets_prefix}
STACK_AWS_REGION=${aws_region}
STACK_DOMAIN=${domain}
STACK_MEMEX_SUBDOMAIN=${memex_subdomain}
STACK_INGRESS_MODE=${ingress_mode}
EOF
chmod 0600 /etc/stack-env

aws s3 cp ${bootstrap_script_url} /tmp/bootstrap.sh
chmod +x /tmp/bootstrap.sh
bash /tmp/bootstrap.sh
