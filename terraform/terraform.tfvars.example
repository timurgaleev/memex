# terraform.tfvars.example — copy to terraform.tfvars (gitignored) and fill in.
# `scripts/init.sh` generates terraform.tfvars automatically — this file
# documents the schema for editors / reviewers / CI.
#
# Required values have no default in variables.tf and MUST be set:
#   - tfstate_bucket       (where terraform state lives — partial backend)
# Optional values pick up sensible defaults from variables.tf if omitted.

# ---------------------------------------------------------------------------
# AWS basics
# ---------------------------------------------------------------------------
aws_region   = "eu-west-1"
aws_profile  = "default"        # the [profile-name] in ~/.aws/config
# tfstate_region   = "eu-central-1"   # only override if your tfstate bucket isn't in eu-central-1

# ---------------------------------------------------------------------------
# Project naming — drives every AWS resource Name tag
# ---------------------------------------------------------------------------
project_name      = "memrain"    # short slug, used in resource Name tags
repo_name         = "memrain"
github_owner      = "your-github-username"
secrets_prefix    = "memrain"    # Secrets Manager namespace: memrain/memrain-public-bearer, etc.

# Upgrading an install created before the rename? Do NOT take the values
# above. Pin every name to the stack's current value first (project_name,
# app_slug, secrets_prefix, db_name, db_username, efs_creation_token, the
# name variables and subdomain) — see UPGRADING.md step 0. Otherwise the plan
# tries to replace the secrets and the RDS subnet group, which
# prevent_destroy stops, and to rename the RDS instance in place
# (rds_identifier), which it does NOT stop: the endpoint changes and the stored
# Postgres URL keeps the old host.

# ---------------------------------------------------------------------------
# Public surface
# ---------------------------------------------------------------------------
domain            = "example.com"
subdomain         = "brain"     # → brain.example.com (public MCP — the live brain ingress)
# ingress_mode    = "cloudflare" # or "caddy": TLS on the instance, no Cloudflare
                                 # dependency (see docs/DEPLOYMENT.md § Alternative)
# caddy_manage_dns = true        # caddy mode: create the A record in Route53

# ---------------------------------------------------------------------------
# Repo URL the EC2 user_data clones at first boot. Public-repo HTTPS by default.
# ---------------------------------------------------------------------------
repo_url          = "https://github.com/your-github-username/memrain.git"

# ---------------------------------------------------------------------------
# Optional — leave blank to skip the feature
# ---------------------------------------------------------------------------
alarm_email       = ""           # CloudWatch alarms → SNS → this email
ssh_allowed_cidr  = ""           # ingress 22 from this CIDR (use SSM instead!)

ssh_public_key    = ""           # ssh-rsa / ssh-ed25519 key to register as the EC2 key pair

# ---------------------------------------------------------------------------
# Legacy — only set true while migrating from a private SSH-clone deploy.
# Public-repo deploys leave this at false.
# ---------------------------------------------------------------------------
use_ssh_deploy_key = false
