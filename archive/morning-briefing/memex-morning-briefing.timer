[Unit]
Description=Fire the morning briefing daily at 07:00 Europe/Berlin

[Timer]
OnCalendar=*-*-* 07:00:00 Europe/Berlin
# If the EC2 was sleeping (spot interruption rare on t4g but possible
# on rebalance) and missed the slot, run as soon as it's back.
Persistent=true
Unit=memex-morning-briefing.service

[Install]
WantedBy=timers.target
