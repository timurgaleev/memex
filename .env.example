# memrain host environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
#
# This file holds the NON-SECRET host config. Secrets (the RDS Postgres URL and
# the public bearer) are NOT here — they are fetched from AWS Secrets Manager
# into deploy/.secrets/memrain.env by deploy/secrets/fetch-secrets.sh at boot.
#
# `scripts/init.sh` generates a filled `.env` for you interactively. Only the
# most common flags are shown below; the FULL reference (every MEMRAIN_* flag,
# its default, and its cost) is in docs/CONFIGURATION.md.
#
# Legacy names: an existing `.env` written before the rename keeps working in
# 1.0.x. Compose falls back to MEMEX_<X> wherever MEMRAIN_<X> is unset (the new
# name wins when both are set). The MEMEX_* names are removed in 1.1.0.

# --- Infrastructure (required) ---------------------------------------------
EFS_MOUNT=/mnt/efs/memory        # host path of the mounted data tree
EFS_REPO=/opt/memrain            # host path of the code checkout (chunkers)
REPO_DIR=/opt/memrain            # repo checkout on the host
AWS_REGION=eu-west-1
AWS_PROFILE=default

# --- Secret names (optional) -----------------------------------------------
# Set only if your secrets keep names other than <prefix>/memrain-* (or the
# older <prefix>/memex-*). Each value is a FULL secret id, used exactly as
# given; fetch-secrets, the bearer rotation and mcp-refresh all read them.
# On an EC2 host scripts/bootstrap.sh rewrites `.env` on every run and keeps
# these four keys (a value set in /etc/stack-env wins over the old `.env`).
# POSTGRES_URL_SECRET_NAME=<prefix>/memex-postgres-url
# PUBLIC_BEARER_SECRET_NAME=<prefix>/memex-public-bearer
# INTERNAL_TOKEN_SECRET_NAME=<prefix>/memex-internal-token
# TUNNEL_TOKEN_SECRET_NAME=<prefix>/cloudflared-tunnel-token

# --- Public ingress --------------------------------------------------------
PUBLIC_HOST=brain.example.com    # public host of the MCP endpoint: <SUBDOMAIN>.<your domain>
SUBDOMAIN=brain                  # first label of PUBLIC_HOST
MEMRAIN_PUBLIC_WRITE=0           # 1 = allow constructive writes over public /mcp
# MEMRAIN_CONCEPTS_BUDGET_USD=0.5 # USD ceiling for one synthesize_concepts run.
#                                # Always on: maxConcepts caps the call COUNT,
#                                # not the spend. Refused concepts keep their
#                                # deterministic narrative.
# MEMRAIN_HTTP_TRUST_PROXY=1     # trust X-Forwarded-For/X-Real-IP as the rate-limit
                                 # key — ONLY behind a proxy that rewrites them
                                 # (Cloudflare/Caddy inject Cf-Connecting-Ip already)

# --- Auth & OAuth (see docs/CONFIGURATION.md "Auth & source scoping") ------
# MEMRAIN_PUBLIC_URL=https://brain.example.com  # issuer the OAuth discovery documents advertise
# MEMRAIN_TENANT_FAIL_CLOSED=1   # an authed caller with no source grant reads nothing
# MEMRAIN_OAUTH_REQUIRE_LOGIN=1  # /authorize needs an operator session (client-mode connectors);
#                                # bootstrap sets it when <prefix>/memrain-admin-bootstrap
#                                # (or the older <prefix>/memex-admin-bootstrap) exists
# MEMRAIN_OAUTH_REFRESH_REUSE_REVOKE=1  # a late replay of a rotated refresh token signs the session out
# MEMRAIN_ENABLE_DCR=1           # let clients self-register (off: operator registers clients);
#                                # boot needs MEMRAIN_OAUTH_REQUIRE_LOGIN=1 (or _INSECURE below)
# MEMRAIN_ENABLE_DCR_INSECURE=1  # also allow client_credentials on self-registered clients — leave off
# MEMRAIN_ASSUME_PUBLIC=1        # treat every request as public ingress (non-Cloudflare proxies)
# MEMRAIN_MCP_RATE_LIMIT_PER_TOKEN_PER_MINUTE=120  # per-credential /mcp cap (unset = off)

# --- Agent jobs and skill optimization (off by default; paid, capped per run) -
# MEMRAIN_AGENT_ENABLED=1        # read-only research agent job kind (`memrain agent run`)
# MEMRAIN_AGENT_TENANT_ENABLED=1 # also let clients with the `agent` scope call submit_agent
# MEMRAIN_AGENT_MAX_USD=0.25     # per-job USD ceiling
# MEMRAIN_SKILLOPT_ENABLED=1     # `memrain skillopt eval`
# MEMRAIN_SKILLOPT_MAX_USD=0.25  # per-run USD ceiling

# --- Optional feature tiers (all default OFF; see docs/CONFIGURATION.md) -----
# Pick a tier. More spend = more quality. Every paid Sonnet slice is capped by
# its own *_BUDGET_USD (default 1.0). GRAPH_RERANK is the main cost swing (Sonnet
# on every search); MEMRAIN_RERANK is the cheap Haiku alternative.

# BALANCED tier (best value — Haiku, ~$5-15/mo): sharper ranking + a self-thinking brain.
# MEMRAIN_RERANK=1               # Haiku two-pass rerank on every search (~$1-3/mo)
# MEMRAIN_RERANK_WINDOW=30       # rerank candidate window (>= k); promotes hits below the return cutoff
# MEMRAIN_DREAM_SYNTHESIS=1      # Haiku synthesis chain on quiet-hours ticks
# MEMRAIN_DOCTOR_PER_SOURCE=1    # per-source health warn check (free)
# MEMRAIN_TENANT_FAIL_CLOSED=1   # deny an authed principal with no source grant

# MAX-QUALITY tier (recommended for best results — paid Sonnet, +$25-390/mo):
# MEMRAIN_GRAPH_RERANK=1         # Sonnet rerank on every search (dominant cost)
# MEMRAIN_RELATIONAL_LLM=1       # Sonnet fallback for the relational arm
# MEMRAIN_THINK=1                # `memrain think` deep synthesis (CLI)
# MEMRAIN_DEEP_SYNTH=1           # scheduled think over top concepts
# MEMRAIN_TAKE_ENSEMBLE=1        # N-judge Sonnet grading of takes
# MEMRAIN_FACTS_EXTRACTION=1     # conversation -> facts
# MEMRAIN_CONTEXTUAL_RETRIEVAL=1 # deterministic embed wrapper — re-embed after
# MEMRAIN_CONTEXTUAL_LLM=1       # PAID per-chunk Haiku context — re-embed after
# MEMRAIN_CONTEXTUAL_LLM_BUDGET_USD=5.0  # total cap for the contextual LLM tier
# MEMRAIN_EMBED_MAX_INFLIGHT=4   # chunks a write embeds at once (1 = serial)
# MEMRAIN_LLM_TIMEOUT_MS=        # shared Bedrock timeout (per-kind defaults otherwise)
