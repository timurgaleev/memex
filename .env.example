# memex host environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
#
# This file holds the NON-SECRET host config. Secrets (the RDS Postgres URL and
# the public bearer) are NOT here — they are fetched from AWS Secrets Manager
# into deploy/.secrets/memex.env by deploy/secrets/fetch-secrets.sh at boot.
#
# `scripts/init.sh` generates a filled `.env` for you interactively. Only the
# most common flags are shown below; the FULL reference (every MEMEX_* flag,
# its default, and its cost) is in docs/CONFIGURATION.md.

# --- Infrastructure (required) ---------------------------------------------
EFS_MOUNT=/mnt/efs/memory        # host path of the mounted data tree
EFS_REPO=/opt/memex              # host path of the code checkout (chunkers)
REPO_DIR=/opt/memex              # repo checkout on the host
AWS_REGION=eu-west-1
AWS_PROFILE=default

# --- Public ingress --------------------------------------------------------
MEMEX_HOST=example.com           # your apex domain
MEMEX_SUBDOMAIN=brain            # brain.<MEMEX_HOST> is the MCP endpoint
MEMEX_PUBLIC_WRITE=0             # 1 = allow constructive writes over public /mcp

# --- Optional feature flags (all default OFF; see docs/CONFIGURATION.md) ----
# Cheap agent layer + tenant posture:
# MEMEX_DREAM_SYNTHESIS=1        # Haiku synthesis chain on quiet-hours ticks
# MEMEX_DOCTOR_PER_SOURCE=1      # per-source health warn check (free)
# MEMEX_TENANT_FAIL_CLOSED=1     # deny an authed principal with no source grant

# Paid Bedrock Sonnet slices (each spends per call, capped by *_BUDGET_USD=1.0):
# MEMEX_THINK=1                  # `memex think` deep synthesis (CLI)
# MEMEX_GRAPH_RERANK=1           # Sonnet rerank on every search
# MEMEX_RELATIONAL_LLM=1         # Sonnet fallback for the relational arm
# MEMEX_DEEP_SYNTH=1             # scheduled think over top concepts
# MEMEX_TAKE_ENSEMBLE=1          # N-judge Sonnet grading of takes
# MEMEX_FACTS_EXTRACTION=1       # conversation -> facts
# MEMEX_CONTEXTUAL_RETRIEVAL=1   # embed wrapper — needs a FULL re-embed first
# MEMEX_CONTEXTUAL_LLM=1         # PAID per-chunk Haiku context — re-embed after
# MEMEX_CONTEXTUAL_LLM_BUDGET_USD=5.0  # total cap for the contextual LLM tier
